#!/bin/sh
# Start guard for guru-worker@.service (ExecStartPre=), called with the
# instance name: `guru-worker-guard %i`.
#
# A self-update swaps /opt/guru-worker-<instance>/bin/current and leaves a
# `pending` marker; the new binary removes it once it has registered with the
# master and sent a health report. This runs before every start and counts the
# starts a pending update has had: a version that keeps failing is rolled back
# to `previous` and the reason is left in `failed`, which the worker reports on
# its next registration. Every marker and link is the instance's own, so one
# instance's update never counts against another's starts. The guard lives
# outside the instance trees on purpose — the worker never writes here, so a
# broken update cannot take the guard down with it, and a binary that does not
# even exec is caught the same way as one that crashes.
#
# Both markers are `key=value` lines: `pending` carries `version` and
# `attempts`, `failed` carries `version` and `error`.
set -eu
case "${1:-}" in
    ''|-*|*[!a-z0-9-]*)
        echo "guru-worker-guard: no valid instance name (got '${1:-}'); not guarding this start" >&2
        exit 0
        ;;
esac
PREFIX="/opt/guru-worker-$1/bin"
PENDING="$PREFIX/pending"
MAX_STARTS=3

[ -f "$PENDING" ] || exit 0
version=$(sed -n 's/^version=//p' "$PENDING")
attempts=$(sed -n 's/^attempts=//p' "$PENDING")
attempts=$(( ${attempts:-0} + 1 ))
if [ "$attempts" -le "$MAX_STARTS" ]; then
    printf 'version=%s\nattempts=%s\n' "$version" "$attempts" >"$PENDING.tmp"
    mv "$PENDING.tmp" "$PENDING"
    exit 0
fi

if [ -L "$PREFIX/previous" ]; then
    rollback=$(readlink "$PREFIX/previous")
    ln -sfn "$rollback" "$PREFIX/current.tmp"
    mv -T "$PREFIX/current.tmp" "$PREFIX/current"
    error="$version did not come up in $MAX_STARTS starts; rolled back to $rollback"
else
    error="$version did not come up in $MAX_STARTS starts and there is no previous version to roll back to"
fi
printf 'version=%s\nerror=%s\n' "$version" "$error" >"$PREFIX/failed.tmp"
mv "$PREFIX/failed.tmp" "$PREFIX/failed"
rm -f "$PENDING"
echo "guru-worker-guard: $error" >&2
exit 0
