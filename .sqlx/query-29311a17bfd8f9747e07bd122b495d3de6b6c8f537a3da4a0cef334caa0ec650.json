  "query": "UPDATE relay_certificate\nSET sni = $2, private_key_pem = $3, certificate_pem = $4,\n    not_before = $5, not_after = $6, version = version + 1\nWHERE pod = $1 AND version = $7\nRETURNING\n    id AS \"id: RelayCertificateId\",\n    pod AS \"pod: PodId\",\n    sni,\n    private_key_pem,\n    certificate_pem,\n    not_before,\n    not_after,\n    version\n",
